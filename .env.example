# Google Gemini (primary provider at deployment)
GOOGLE_API_KEY=
# Alternative providers (used if their key is set and LLM_PROVIDER points at them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides: provider auto-detects from available keys if unset
LLM_PROVIDER=
LLM_MODEL=
# Force offline canned responses (numeric sim still runs; shocks stay random)
MOCK_LLM=false
